# Variables de entorno del RAG de documentos.
# Copiar a .env y completar. NUNCA subir .env a Git.

# Clave de Google (para embeddings gemini-embedding-001 y modelo de chat)
GOOGLE_API_KEY=

# Modelo de chat del agente
MODELO=gemini-3.5-flash-lite

# Modelo de embeddings
EMBEDDING_MODELO=gemini-embedding-001

# Direccion de Redis (solo si se usa el backend Redis; el default es FAISS)
REDIS_URL=redis://localhost:6379/0

# Backend de vectores: faiss (por defecto) o redis
VECTOR_BACKEND=faiss
